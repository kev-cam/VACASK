// sch_path: /home/alberto/Scripts/VACASK/VACASK_cosim/demo/cosim/vacask_cosim_hier/tb_sar_adc.sch
//subckt tb_sar_adc ( )
R2 ( 'D[5]' SUM ) resistor r=2M $mfactor=1 
R3 ( 'D[4]' SUM ) resistor r=4M $mfactor=1 
R4 ( 'D[3]' SUM ) resistor r=8M $mfactor=1 
R5 ( 'D[2]' SUM ) resistor r=16M $mfactor=1 
R6 ( 'D[1]' SUM ) resistor r=32M $mfactor=1 
R7 ( 'D[0]' SUM ) resistor r=64M $mfactor=1 
V3 ( VCC 0 ) vsource dc=1.8 
V2 ( INPUT 0 ) vsource type="pulse" val0=0 val1=1.7 delay=0 rise=200u fall=200u width=1u period=402u 
V1 ( START 0 ) vsource type="pulse" val0=0 val1=VCC delay=0.2u rise=10n fall=10n width=1.3u period=10u 
V4 ( CLK 0 ) vsource type="pulse" val0=0 val1='VCC' delay=500n rise=10n fall=10n width=490n period=1u 
x1 ( INPUT VCC START VALID 'D[5]' 'D[4]' 'D[3]' 'D[2]' 'D[1]' 'D[0]' CLK ) sar_adc 
x2 ( VALID_A VALID ) dac_bridge 
R1 ( SUM 0 ) resistor r=1G $mfactor=1 
//// begin user architecture code


ground 0

load "resistor.osdi"
load "capacitor.osdi"
load "dac_bridge.osdi"
load "acomp.osdi"

parameters VCC=1.8

control
  tran tran1 tstop=250u tstep=100n
endc





include "sg13g2_vacask_common.lib"
include "cornerMOSlv.lib" section=mos_tt
include "cornerMOShv.lib" section=mos_tt
include "cornerHBT.lib" section=hbt_typ
include "cornerRES.lib" section=res_typ
include "cornerCAP.lib" section=cap_typ


//// end user architecture code
//ends

// expanding   symbol:  /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/sar_adc.sym # of pins=6
// sym_path: /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/sar_adc.sym
// sch_path: /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/sar_adc.sch
subckt sar_adc ( INPUT VREF START VALID 'D[5]' 'D[4]' 'D[3]' 'D[2]' 'D[1]' 'D[0]' CLK )
//.ipin INPUT
//.ipin VREF
//.ipin START
//.opin VALID
//.ipin CLK
//.opin D[5],D[4],D[3],D[2],D[1],D[0]
CLAST ( TEST_V 0 ) capacitor c=31.25f $mfactor=1 
R1 ( IIN TEST_V ) resistor r=1k $mfactor=1 
x1 ( INPUT IIN SAMPLE VREF ) tgate 
x2 ( TEST_V VREF 'D[0]' ) ccap C=1p/32 
x3 ( TEST_V VREF 'D[1]' ) ccap C=1p/16 
x4 ( TEST_V VREF 'D[2]' ) ccap C=1p/8 
x5 ( TEST_V VREF 'D[3]' ) ccap C=1p/4 
x6 ( TEST_V VREF 'D[4]' ) ccap C=1p/2 
x7 ( TEST_V VREF 'D[5]' ) ccap C=1p 
x8 ( CLK COMP VALID 'D[5]' 'D[4]' 'D[3]' 'D[2]' 'D[1]' 'D[0]' SAMPLE START ) sar_adc_vlog 
DAC ( COMP_A COMP ) dac_bridge 
x9 ( COMP net1 TEST_V ) acomp 
V1 ( net1 0 ) vsource dc=0.9 
ends 


// expanding   symbol:  /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/dac_bridge.sym # of pins=2
// sym_path: /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/dac_bridge.sym
// sch_path: /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/dac_bridge.sch
subckt dac_bridge ( aout din )
//.opin aout
//.ipin din
//// begin user architecture code


model dac_model dac vth=0.9 vsoft=10m vout_low=0 vout_high=1.8
DAC (din aout) dac_model


//// end user architecture code
ends 


// expanding   symbol:  /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/tgate.sym # of pins=4
// sym_path: /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/tgate.sym
// sch_path: /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/tgate.sch
subckt tgate ( A B CTL VDD )
//.ipin CTL
//.iopin B
//.iopin A
//.ipin VDD
XM1 ( A CTL B 0 ) sg13_lv_nmos w=5u l=0.13u ng=1 m=1 
ends 


// expanding   symbol:  /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/ccap.sym # of pins=3
// sym_path: /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/ccap.sym
// sch_path: /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/ccap.sch
subckt ccap ( IN VCC CTL )
parameters C=1p 
//.ipin IN
//.ipin VCC
//.ipin CTL
CB ( IN TAIL ) capacitor c='C' $mfactor=1 
x1 ( CTL TAIL VCC ) ainv 
ends 


// expanding   symbol:  /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/sar_adc_vlog.sym # of pins=6
// sym_path: /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/sar_adc_vlog.sym
// sch_path: /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/sar_adc_vlog.sch
subckt sar_adc_vlog ( Clk Comp Done 'Result[5]' 'Result[4]' 'Result[3]' 'Result[2]' 'Result[1]' 'Result[0]' Sample Start )
//.ipin Clk
//.opin Sample
//.ipin Comp
//.ipin Start
//.opin Done
//.opin Result[5],Result[4],Result[3],Result[2],Result[1],Result[0]
Rclk ( 0 Clk ) resistor r=1G $mfactor=1 
R3 ( 0 Sample ) resistor r=1G $mfactor=1 
R2 ( 0 Done ) resistor r=1G $mfactor=1 
R1 ( 0 'Result[5]' ) resistor r=1G $mfactor=1 
Rclk1 ( 0 Comp ) resistor r=1G $mfactor=1 
Rclk2 ( 0 Start ) resistor r=1G $mfactor=1 
ends 


// expanding   symbol:  /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/acomp.sym # of pins=3
// sym_path: /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/acomp.sym
// sch_path: /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/acomp.sch
subckt acomp ( dout ain2 ain1 )
//.ipin ain1
//.opin dout
//.ipin ain2
//// begin user architecture code


model comparator_model comparator vout_low=0 vout_high=1.8
ACOMP (ain1 ain2 dout) comparator_model


//// end user architecture code
ends 


// expanding   symbol:  /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/ainv.sym # of pins=3
// sym_path: /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/ainv.sym
// sch_path: /home/alberto/Scaricati/ngspice_verilog_cosim/vacask_cosim_hier/final_folder/ainv.sch
subckt ainv ( IN OUT VDD )
//.ipin IN
//.opin OUT
//.ipin VDD
XM1 ( OUT IN 0 0 ) sg13_lv_nmos w=5u l=0.13u ng=1 m=1 
XM2 ( OUT IN VDD VDD ) sg13_lv_pmos w=5u l=0.13u ng=1 m=1 
ends 

//// begin user architecture code
model vsource vsource
load "resistor.osdi"
model resistor resistor
load "capacitor.osdi"
model capacitor capacitor
//// end user architecture code
